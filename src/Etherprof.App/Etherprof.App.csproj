<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Etherprof</AssemblyName>
    <RootNamespace>Etherprof.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Etherprof.Contracts\Etherprof.Contracts.csproj" />
    <ProjectReference Include="..\Etherprof.Core\Etherprof.Core.csproj" />
    <ProjectReference Include="..\Etherprof.Storage\Etherprof.Storage.csproj" />
    <ProjectReference Include="..\Etherprof.Network.Windows\Etherprof.Network.Windows.csproj" />
    <ProjectReference Include="..\Etherprof.Testing\Etherprof.Testing.csproj" />
    <ProjectReference Include="..\Etherprof.Wifi.Windows\Etherprof.Wifi.Windows.csproj" />
    <ProjectReference Include="..\Etherprof.SpeedTest\Etherprof.SpeedTest.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>
</Project>
