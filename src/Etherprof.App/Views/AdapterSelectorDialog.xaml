<Window x:Class="Etherprof.App.Views.AdapterSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Adapter" 
        Width="460" SizeToContent="Height" MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Select adapters to show" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="showAllBtn" Content="Show All / Reset" DockPanel.Dock="Right" HorizontalAlignment="Right" 
                    Padding="6,2" FontSize="11" Click="OnShowAll" ToolTip="Show all physical adapters to adjust selection" />
        </DockPanel>
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="adapterList" />
        </ScrollViewer>
        <Button Content="Close" Width="80" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="8,4" Click="OnClose" />
    </StackPanel>
</Window>
