<Window x:Class="Etherprof.App.Views.TracerouteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traceroute" 
        Width="560" Height="440"
        MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Target & Options Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Target:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="targetHostText" Text="192.168.1.1" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox x:Name="resolveNamesCheck" Content="Resolve names" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="When unchecked (recommended), runs with -d for fast IP-only hops without DNS lookups" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="startStopButton" Content="■ Stop" Width="75" Padding="6,3" FontWeight="SemiBold" Margin="0,0,6,0" Click="OnStartStopClick" />
                <Button Content="📋 Copy" Width="65" Padding="6,3" Margin="0,0,6,0" ToolTip="Copy all output to clipboard" Click="OnCopyClick" />
                <Button Content="Close" Width="60" Padding="6,3" IsCancel="True" Click="OnCloseClick" />
            </StackPanel>
        </DockPanel>

        <!-- Row 1: Status & Running Indicator -->
        <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock x:Name="statusText" Text="Status: Starting traceroute..." FontSize="11" Foreground="#475569" FontWeight="Medium" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Row 2: Console Output Box -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
            <TextBox x:Name="outputBox"
                     Background="Transparent"
                     Foreground="#38BDF8"
                     FontFamily="Consolas"
                     FontSize="11"
                     BorderThickness="0"
                     Padding="8"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Border>

        <!-- Row 3: Footer note -->
        <TextBlock Grid.Row="3" Text="Powered by Windows tracert. Running with -d skips DNS lookups for instant hop discovery."
                   FontSize="10" Foreground="#94A3B8" Margin="0,6,0,0" />
    </Grid>
</Window>
