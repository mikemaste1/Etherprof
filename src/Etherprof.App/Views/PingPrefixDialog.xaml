<Window x:Class="Etherprof.App.Views.PingPrefixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subnet Discovery Notebook" 
        Width="470" Height="500"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Prefix Input & Notebook Info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel Margin="0,0,0,4">
                <TextBlock x:Name="notebookHeader" Text="Notebook Scan #1" FontWeight="Bold" FontSize="12" Foreground="#0F766E" />
                <TextBlock x:Name="timestampHeader" Text="Time: 21:45:00" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
            </DockPanel>
            <TextBlock Text="Subnet Prefix (CIDR)" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="prefixBox" FontFamily="Consolas" FontSize="13" Padding="6,4" VerticalAlignment="Center" />
                <Button Content="📋" Grid.Column="1" Width="28" Height="28" FontSize="11" Margin="4,0,0,0" ToolTip="Paste prefix from clipboard" Click="OnPastePrefix" />
                <Button x:Name="scanButton" Content="🔍 Scan Subnet" Grid.Column="2" Padding="12,4" FontWeight="SemiBold" Margin="6,0,0,0"
                        Background="#DCFCE7" BorderBrush="#86EFAC" Foreground="#15803D"
                        Click="OnScanToggle" />
            </Grid>
            <TextBlock x:Name="hintText" Text="Proposed from active network interface" FontSize="10" Foreground="#64748B" Margin="0,4,0,0" />
            <TextBlock x:Name="errorText" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed" />
        </StackPanel>

        <!-- Row 1: Progress & Status -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="statusText" Text="Ready to scan" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                    <TextBlock x:Name="countText" Text="0 found" FontSize="11" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right" />
                </DockPanel>
                <ProgressBar x:Name="progressBar" Height="6" Maximum="100" Value="0" Foreground="#16A34A" Background="#E2E8F0" BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- Row 2: Discovered Alive Hosts List -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
            <Grid>
                <ListView x:Name="hostsListView" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Select" Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Host IP" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IpAddress}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Latency" Width="85">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LatencyText}" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="ALIVE" FontSize="9" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="emptyNotice" Text="No hosts discovered yet. Press Scan Subnet to start." 
                           Foreground="#94A3B8" FontSize="11" FontStyle="Italic"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Row 3: Action Buttons -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Close" Width="65" Padding="8,4" Margin="0,0,6,0" Click="OnClose" />
                <Button Content="🗕 Minimize" Width="85" Padding="8,4" ToolTip="Minimize notebook window to taskbar" Click="OnMinimize" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📋 Copy Hosts" Padding="10,4" Margin="0,0,6,0" Click="OnCopyHosts" ToolTip="Copy discovered host IPs to clipboard" />
                <Button x:Name="startPingButton" Content="▶ Ping Found Hosts" Padding="12,4" FontWeight="SemiBold"
                        Background="#DCFCE7" BorderBrush="#86EFAC" Foreground="#15803D"
                        Click="OnStartPingHosts" IsEnabled="False"
                        ToolTip="Start continuous ping test with discovered hosts in Etherprof" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
