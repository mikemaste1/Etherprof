<Window x:Class="Etherprof.App.Views.BssidAliasEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Access Point Label"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="BSSID" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2" />
        <TextBlock Grid.Row="1" Text="{Binding Bssid}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Text="Alias" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2" />
        <TextBox Grid.Row="3" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="4,3" Margin="0,0,0,16" x:Name="aliasTextBox" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}" Width="75" Margin="0,0,8,0" Style="{StaticResource ActionButton}" />
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" Width="75" Style="{StaticResource ActionButton}" />
        </StackPanel>
    </Grid>
</Window>
