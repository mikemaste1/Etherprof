<Window x:Class="Etherprof.App.Views.LiveQrScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Etherprof.App.Converters"
        Title="Etherprof Live QR Scanner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Width="380"
        Height="320"
        ResizeMode="NoResize"
        MouseDown="OnWindowMouseDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="HudButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#475569" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A" BorderBrush="#22C55E" BorderThickness="1.5"
            CornerRadius="8" Padding="6" Margin="6" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.6" ShadowDepth="3" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header Drag Bar -->
                <RowDefinition Height="Auto" />
                <!-- 1: Live Video Viewfinder -->
                <RowDefinition Height="*" />
                <!-- 2: Bottom Control Toolbar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0: Header -->
            <DockPanel Grid.Row="0" Margin="2,0,2,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📌" Click="OnToggleTopmostClicked" Style="{StaticResource HudIconButton}"
                            FontSize="11" Width="20" Height="20" Margin="0,0,2,0"
                            ToolTip="Toggle Always On Top" />
                    <Button Content="✕" Click="OnCloseClicked" Style="{StaticResource HudIconButton}"
                            FontSize="11" Width="20" Height="20"
                            ToolTip="Close Live Scanner &amp; Stop Camera" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Drag Grip -->
                    <TextBlock Text="⋮⋮" FontSize="13" Foreground="#64748B" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="2,0,6,0" Cursor="SizeAll"
                               ToolTip="Drag to position detached live video bar" />

                    <!-- Live Indicator Dot -->
                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,4,0" VerticalAlignment="Center" />

                    <!-- Header Title -->
                    <TextBlock Text="LIVE QR SCANNER" FontSize="10" FontWeight="Bold" Foreground="#22C55E"
                               VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBlock Text="ON THE FLY" FontSize="8" FontWeight="SemiBold" Foreground="#10B981"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                </StackPanel>
            </DockPanel>

            <!-- 1: Live Video Viewfinder Area -->
            <Border Grid.Row="1" Background="#020617" BorderBrush="#1E293B" BorderThickness="1"
                    CornerRadius="4" ClipToBounds="True" Margin="0,0,0,4" MinHeight="190">
                <Grid>
                    <!-- Live Camera Frame -->
                    <Image Source="{Binding QrScanPanel.LiveVideoFrame}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Fallback Placeholder when camera is initializing or no frame -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding QrScanPanel.HasLiveVideoFrame, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock Text="📷" FontSize="28" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="Accessing camera feed…" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
                        <TextBlock Text="Hold QR code in view to scan on the fly" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Scanning Reticle Overlay -->
                    <Grid IsHitTestVisible="False" Margin="16"
                          Visibility="{Binding QrScanPanel.HasLiveVideoFrame, Converter={StaticResource BoolToVis}}">
                        <!-- Top-Left Corner Bracket -->
                        <Path Stroke="#22C55E" StrokeThickness="2.5" Data="M 0,20 L 0,0 L 20,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <!-- Top-Right Corner Bracket -->
                        <Path Stroke="#22C55E" StrokeThickness="2.5" Data="M 0,0 L 20,0 L 20,20" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <!-- Bottom-Left Corner Bracket -->
                        <Path Stroke="#22C55E" StrokeThickness="2.5" Data="M 0,0 L 0,20 L 20,20" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <!-- Bottom-Right Corner Bracket -->
                        <Path Stroke="#22C55E" StrokeThickness="2.5" Data="M 0,20 L 20,20 L 20,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                        <!-- Center Aim Dot -->
                        <Ellipse Width="6" Height="6" Fill="#22C55E" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Notification Banner (Appears when code is detected on the fly) -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="6"
                            Background="#16A34A" CornerRadius="4" Padding="8,4"
                            Visibility="{Binding QrScanPanel.HasLiveDecodeNotification, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Click="OnDismissNotificationClicked"
                                    Style="{StaticResource HudIconButton}" Foreground="White" FontSize="9" Width="14" Height="14" />
                            <TextBlock Text="{Binding QrScanPanel.LiveDecodeNotification}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2: Bottom Control Toolbar -->
            <DockPanel Grid.Row="2" Margin="2,0,2,0">
                <!-- Action Buttons: Paste, Save Wi-Fi, Copy -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📋 Paste Image" Command="{Binding QrScanPanel.PasteImageAndDecodeCommand}"
                            Style="{StaticResource HudButton}" Height="22" Margin="0,0,4,0"
                            ToolTip="Decode QR code from image in clipboard (Ctrl+V)" />

                    <Button Content="💾 Ingest Profile" Command="{Binding QrScanPanel.IngestWifiProfileCommand}"
                            Visibility="{Binding QrScanPanel.IsWifiPayload, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource HudButton}" Background="#15803D" BorderBrush="#16A34A"
                            Height="22" Margin="0,0,4,0" ToolTip="Save decoded Wi-Fi network and copy password" />

                    <Button Content="🔑 Copy Key" Command="{Binding QrScanPanel.CopyPasswordCommand}"
                            Visibility="{Binding QrScanPanel.HasPassword, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource HudButton}" Height="22" Margin="0,0,4,0"
                            ToolTip="Copy Wi-Fi security key to clipboard" />

                    <Button Content="📋 Copy Raw" Command="{Binding QrScanPanel.CopyPayloadCommand}"
                            Visibility="{Binding QrScanPanel.HasDecodedText, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource HudButton}" Height="22"
                            ToolTip="Copy full decoded QR payload" />
                </StackPanel>

                <!-- Status Text on Right -->
                <TextBlock Text="{Binding QrScanPanel.StatusMessage}" FontSize="9" Foreground="#94A3B8"
                           VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
